# MySQL Docker connection
# Default DSN for Docker MySQL
# root:root = username:password
#localhost:3307 = Docker mapped port
# bookstore = database name
DB_DSN=root:root@tcp(db:3306)/bookstore?charset=utf8&parseTime=True&loc=Local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bookstore
JWT_SECRET=secret
PORT=8080
REDIS_ADDR=localhost:6379
