# MySQL Docker connection
# Default DSN for Docker MySQL
# root:root = username:password
#localhost:3307 = Docker mapped port
# bookstore = database name
DB_DSN=root:root@tcp(127.0.0.1:3307)/bookstore?charset=utf8&parseTime=True&loc=Local
DB_HOST= 3307
DB_USER=password
DB_PASSWORD=root
DB_NAME=bookstore